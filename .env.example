# Gandalf Protocol — env.  ⚠️ MOST PEOPLE DON'T NEED THIS FILE.
#
# To RUN experiments, use the DEPLOYED app — the key lives server-side, you need nothing:
#     https://ca-gandalf-protocol.wittyflower-1831f2a2.westus2.azurecontainerapps.io
#     (open it, or:  curl -X POST "$URL/api/run?condition=swarm&rounds=3" )
#
# You only need a local key if you're running the loop ON YOUR MACHINE to debug it.
# In that case: cp .env.example .env  and fill the two values below.
# Leave them as-is (or unset) → the app runs in MOCK mode (zero cost), it will NOT prompt you.

# Gateway base URL (not secret).
ANTHROPIC_BASE_URL=https://ca-litellm-gateway.wittyflower-1831f2a2.westus2.azurecontainerapps.io

# The shared gateway key (budget-capped, revocable — NOT a raw sk-ant key). Get it from the
# pinned issue #2, Teams, or Kirk. If left as this placeholder, the app stays in MOCK — it
# will NOT error or "ask" for a key.
ANTHROPIC_API_KEY=<optional — only for local loop debugging; see issue #2>

# Optional: Azure Blob store (leave unset for local store.json)
# AZURE_STORAGE_CONNECTION_STRING=

# Optional: Actian VectorAI DB for semantic playbook retrieval (falls back to local if unset)
# ACTIAN_CONNECTION_STRING=
